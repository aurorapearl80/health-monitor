<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    app:boxedEdges="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Messages"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:textColor="@color/accent_gold"/>

        <Button
            android:id="@+id/btn_compose"
            style="@style/Watch.Button.Measure"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="+ New Message"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/tabs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/stat_item_background"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tab_read"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Read"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/accent_gold"/>

            <TextView
                android:id="@+id/tab_unread"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Unread"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_muted"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.wear.widget.WearableRecyclerView
                android:id="@+id/messages_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_gold"
                    android:layout_marginBottom="12dp"
                    style="?android:attr/progressBarStyle"/>

                <TextView
                    android:id="@+id/loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading messages..."
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:maxLines="2"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>
