<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/watch_inset_vertical">

        <TextView
            style="@style/Vital.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Messages"
            android:layout_marginBottom="8dp" />

        <!-- Segmented control: Read / Unread -->
        <LinearLayout
            android:id="@+id/tabs_container"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_segmented"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tab_read"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Read"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="@android:color/white"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/border_color" />

            <TextView
                android:id="@+id/tab_unread"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Unread"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.wear.widget.WearableRecyclerView
                android:id="@+id/messages_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/page_bottom_inset"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
                android:scrollbarFadeDuration="400"
                android:scrollbarDefaultDelayBeforeFade="1800"
                android:overScrollMode="ifContentScrolls"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/scroll_fade_length"
                android:clipToPadding="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/brand"
                    android:layout_marginBottom="10dp"
                    style="?android:attr/progressBarStyle"/>

                <TextView
                    android:id="@+id/loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading messages..."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:maxLines="2"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>
