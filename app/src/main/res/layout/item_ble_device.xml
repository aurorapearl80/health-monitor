<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="12dp"
    android:paddingVertical="6dp"
    android:background="@drawable/device_card_background"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/checkbox_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:buttonTint="@color/brand" />

        <TextView
            android:id="@+id/text_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device Name"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- Address / serial lines stay hidden by default, as before -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAC:"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginEnd="4dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/text_device_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00:00:00:00:00"
                android:textSize="10sp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SN:"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginEnd="4dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/text_device_serial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="XXXXX"
                android:textSize="10sp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
