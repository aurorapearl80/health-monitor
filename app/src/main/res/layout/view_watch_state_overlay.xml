<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingHorizontal="22dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/heart_rate_line"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fitness_watch" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Vital.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Please wear the device" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/Vital.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="During measurement please stay still" />
    </LinearLayout>
</FrameLayout>
