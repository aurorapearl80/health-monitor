<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    app:boxedEdges="all">

    <androidx.wear.widget.SwipeDismissFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="@dimen/watch_inset_horizontal"
            android:paddingRight="@dimen/watch_inset_horizontal"
            android:paddingTop="@dimen/watch_inset_vertical"
            android:paddingBottom="@dimen/watch_inset_vertical"
            android:clipToPadding="true"
            android:scrollbarStyle="outsideInset"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/Watch.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weight" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_value_bg"
                            style="@style/Watch.Hero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/accent_green" />

                        <TextView
                            android:id="@+id/tvUnit"
                            style="@style/Watch.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_body_composition_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Body composition"
                        android:textSize="9sp"
                        android:textColor="@color/accent_gold"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:layout_marginTop="2dp"
                        android:gravity="center" />

                    <LinearLayout
                        android:id="@+id/bodyCompositionRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvBodyWater"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WATER"
                                android:textSize="7sp"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvLeanMass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LEAN"
                                android:textSize="7sp"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvFatMass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FAT"
                                android:textSize="7sp"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvBodyFatPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FAT %"
                                android:textSize="7sp"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_time_ago"
                        style="@style/Watch.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvBMIStatus"
                        style="@style/Watch.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvBPM"
                        style="@style/Watch.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BMI: "
                        android:layout_marginEnd="8dp"
                        android:gravity="center" />

                    <ImageView
                        android:id="@+id/heartIcon"
                        android:layout_width="16dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_weight_foreground"
                        app:tint="@color/accent_green"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/tvOutcome"
                        style="@style/Watch.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/accent_gold"
                        android:gravity="center" />

                    <ImageView
                        android:id="@+id/chartIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chart"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="12dp"
                        app:tint="@color/accent_gold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/watch_hairline"
                    android:layout_marginVertical="@dimen/card_spacing"/>

                <include
                    android:id="@+id/metricsPanel"
                    layout="@layout/layout_metrics_panel" />

                <include layout="@layout/include_quick_actions" />

            </LinearLayout>

        </ScrollView>

    </androidx.wear.widget.SwipeDismissFrameLayout>

    <ImageView
        android:id="@+id/ivConnectionStatus"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:contentDescription="Connection status"
        app:tint="@color/accent_gold" />

</androidx.wear.widget.BoxInsetLayout>
