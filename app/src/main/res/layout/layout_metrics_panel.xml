<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/metricsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="14dp"
    android:showDividers="middle"
    android:divider="@drawable/divider_space">

    <!-- Each row carries the accent of the vital it shows. -->
    <include
        android:id="@+id/rowGlucose"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Glucose"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam" />

    <include
        android:id="@+id/rowBloodPressure"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Pressure"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam" />

    <include
        android:id="@+id/rowWeight"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Weight"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam"/>

    <include
        android:id="@+id/rowBloodOxygen"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Oxygen"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam"/>

    <include
        android:id="@+id/rowEcg"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Ecg"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam"/>

    <include
        android:id="@+id/temperature"
        layout="@layout/item_metric_compact"
        android:theme="@style/ThemeOverlay.Vital.Temperature"
        android:layout_marginHorizontal="@dimen/metric_card_margin_h"
        tools:ignore="IncludeLayoutParam"/>

</LinearLayout>
