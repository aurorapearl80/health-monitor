<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <com.monitor.health.ui.widget.VitalBezelView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/page_top_inset"
        android:paddingBottom="@dimen/page_bottom_inset"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarFadeDuration="400"
        android:scrollbarDefaultDelayBeforeFade="1800"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/scroll_fade_length"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_background"
                android:contentDescription="Profile photo"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <TextView
                android:id="@+id/user_name"
                style="@style/Vital.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="User Name"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/user_status"
                style="@style/Vital.Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/status_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Active"
                android:textColor="?attr/vitalAccent" />

            <TextView
                style="@style/Vital.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Today" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stats_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/quick_actions_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/action_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/action_button_background"
                    android:contentDescription="Sign out"
                    android:padding="12dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warning" />

                <ImageView
                    android:id="@+id/action_health"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/action_button_background"
                    android:contentDescription="Devices"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/action_notifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/action_button_background"
                        android:contentDescription="Messages"
                        android:padding="12dp"
                        android:src="@drawable/ic_message"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/message_badge"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_badge_circle"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/ivConnectionStatus"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="9dp"
        android:contentDescription="Connection status"
        android:visibility="invisible" />

</androidx.wear.widget.BoxInsetLayout>
