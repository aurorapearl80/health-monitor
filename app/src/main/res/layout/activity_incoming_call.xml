<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background">

    <com.monitor.health.ui.widget.VitalBezelView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:bezelColor="@color/success"
        app:bezelSweep="150" />

    <!-- Call action buttons, anchored to the bottom -->
    <LinearLayout
        android:id="@+id/call_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/decline_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/decline_button_background"
            android:src="@drawable/ic_call_end"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/decline"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/accept_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/accept_button_background"
            android:src="@drawable/ic_call"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/answer"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Caller, centred in the space above the buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/call_actions"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp">

        <ImageView
            android:id="@+id/caller_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_profile"
            android:background="@drawable/circle_background"
            android:padding="2dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/incoming_call_text"
            style="@style/Vital.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Incoming call"
            android:textColor="@color/success"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Unknown"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
