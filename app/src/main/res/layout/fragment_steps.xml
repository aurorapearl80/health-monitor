<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:theme="@style/ThemeOverlay.Vital.Steps">

    <com.monitor.health.ui.widget.VitalBezelView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/page_top_inset"
        android:paddingBottom="@dimen/page_bottom_inset"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarFadeDuration="400"
        android:scrollbarDefaultDelayBeforeFade="1800"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/scroll_fade_length"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/bpm"
                    style="@style/Vital.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Steps" />

                <!-- Live step count -->
                <TextView
                    android:id="@+id/heart"
                    style="@style/Vital.Text.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/heart_rate_line"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/walking" />

                <TextView
                    android:id="@+id/tv_status"
                    style="@style/Vital.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Idle" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="96dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/vitalAccent"
                    android:visibility="gone" />

                <!-- Last synced total -->
                <TextView
                    android:id="@+id/tv_value"
                    style="@style/Vital.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFeatureSettings="tnum"
                    android:text="--"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_measure"
                    style="@style/Widget.Vital.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Measure" />

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
