<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <com.monitor.health.ui.widget.VitalBezelView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/page_top_inset"
        android:paddingBottom="@dimen/page_bottom_inset"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarFadeDuration="400"
        android:scrollbarDefaultDelayBeforeFade="1800"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/scroll_fade_length"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/Vital.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Devices"
                    android:gravity="center" />

                <TextView
                    style="@style/Vital.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select a device"
                    android:gravity="center" />

                <TextView
                    style="@style/Vital.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bluetooth devices nearby"
                    android:gravity="center"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_search_devices"
                    style="@style/Widget.Vital.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search for devices"
                    android:textSize="12sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@color/brand"
                android:visibility="visible" />

            <androidx.wear.widget.WearableRecyclerView
                android:id="@+id/recycler_view_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty_state_text"
                style="@style/Vital.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Searching for devices..."
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
