<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    app:boxedEdges="all">

    <androidx.wear.widget.SwipeDismissFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="@dimen/watch_inset_horizontal"
            android:paddingRight="@dimen/watch_inset_horizontal"
            android:paddingTop="@dimen/watch_inset_vertical"
            android:paddingBottom="@dimen/watch_inset_vertical"
            android:clipToPadding="true"
            android:scrollbarStyle="outsideInset"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/card_spacing">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivConnectionStatus"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="Connection status"
                            app:tint="@color/accent_gold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/Watch.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="Glucose" />

                        <TextView
                            android:id="@+id/tvValueBG"
                            style="@style/Watch.Hero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="---"
                            android:textColor="@color/accent_blue" />

                        <TextView
                            android:id="@+id/tvUnit"
                            style="@style/Watch.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--" />

                        <TextView
                            android:id="@+id/tvTimeAgo"
                            style="@style/Watch.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="---" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvBPM"
                            style="@style/Watch.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:id="@+id/heartIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_blood_drop_foreground"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/accent_blue"
                            tools:ignore="UseAppTint"/>

                        <TextView
                            android:id="@+id/tvOutcome"
                            style="@style/Watch.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/accent_gold"/>

                        <ImageView
                            android:id="@+id/chartIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chart"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="12dp"
                            app:tint="@color/accent_gold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/watch_hairline"
                    android:layout_marginVertical="@dimen/card_spacing"/>
                <include
                    android:id="@+id/metricsPanel"
                    layout="@layout/layout_metrics_panel" />

                <include layout="@layout/include_quick_actions" />
            </LinearLayout>
        </ScrollView>
    </androidx.wear.widget.SwipeDismissFrameLayout>


</androidx.wear.widget.BoxInsetLayout>
