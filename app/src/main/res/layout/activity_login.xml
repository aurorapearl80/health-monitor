<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <com.monitor.health.ui.widget.VitalBezelView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/page_top_inset"
        android:paddingBottom="@dimen/page_bottom_inset"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarFadeDuration="400"
        android:scrollbarDefaultDelayBeforeFade="1800"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/scroll_fade_length"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_login"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/login_icon" />

            <TextView
                style="@style/Vital.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sign in"
                android:textSize="17sp" />

            <TextView
                style="@style/Vital.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="to start monitoring" />

            <EditText
                android:id="@+id/et_email"
                style="@style/Widget.Vital.Field"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/et_password"
                    style="@style/Widget.Vital.Field"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingEnd="42dp"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />

                <ImageView
                    android:id="@+id/iv_toggle_password"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Show password"
                    android:alpha="0.6"
                    android:padding="7dp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_login"
                style="@style/Widget.Vital.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sign in"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress_login"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/brand"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
