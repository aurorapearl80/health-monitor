<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingLeft="@dimen/watch_inset_horizontal"
        android:paddingRight="@dimen/watch_inset_horizontal"
        android:paddingTop="@dimen/page_top_inset"
        android:paddingBottom="@dimen/page_bottom_inset"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarFadeDuration="400"
        android:scrollbarDefaultDelayBeforeFade="1800"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/scroll_fade_length"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/Vital.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New message"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/edt_to"
                style="@style/Widget.Vital.Field"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="To provider"
                android:inputType="textPersonName"/>

            <EditText
                android:id="@+id/edt_subject"
                style="@style/Widget.Vital.Field"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Subject"
                android:inputType="textCapSentences"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/edt_message"
                style="@style/Widget.Vital.Field"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:hint="Message"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btn_send"
                style="@style/Widget.Vital.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
