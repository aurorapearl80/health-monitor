<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:paddingLeft="@dimen/watch_inset_horizontal"
    android:paddingRight="@dimen/watch_inset_horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="@dimen/page_bottom_inset"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarSize="4dp"
    android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
    android:scrollbarFadeDuration="400"
    android:scrollbarDefaultDelayBeforeFade="1800"
    android:overScrollMode="ifContentScrolls"
    android:requiresFadingEdge="vertical"
    android:fadingEdgeLength="@dimen/scroll_fade_length"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp">
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/tvReadings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:text="41 readings"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tvAverage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="106.7 lb\nAVERAGE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border_color" />
            <TextView
                android:id="@+id/tvInRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2.4 %\nIN RANGE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvOutOfRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="97.6 %\nOUT OF RANGE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="start"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Date / Time"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Reading Values"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:gravity="center" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Goal Achieved"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:gravity="end" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>