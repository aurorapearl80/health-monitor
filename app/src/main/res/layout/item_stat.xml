<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:background="@drawable/stat_item_background"
    android:paddingStart="8dp"
    android:paddingEnd="14dp"
    android:paddingVertical="7dp"
    android:layout_marginVertical="3dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/stat_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_icon_well"
        android:padding="7dp"
        android:src="@drawable/ic_step"
        android:contentDescription="@null"
        app:tint="?attr/vitalAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stat Title"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:text="Value"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
