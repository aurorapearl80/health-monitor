<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================= Typography ================= -->
    <!-- Small caps label that names the vital; coloured with the screen accent. -->
    <style name="Vital.Text.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/vitalAccent</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- The one number the screen exists for. -->
    <style name="Vital.Text.Hero" parent="">
        <item name="android:textSize">@dimen/hero_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Vital.Text.Hero.Small">
        <item name="android:textSize">@dimen/hero_text_small</item>
    </style>
    <style name="Vital.Text.Unit" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Vital.Text.Title" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Vital.Text.Body" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Vital.Text.Caption" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Vital.Text.Chip" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- Section header above a list of cards. -->
    <style name="Vital.Text.Section" parent="">
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ================= Buttons ================= -->
    <!-- Default pill button: filled with the screen accent, dark label. -->
    <style name="Widget.Vital.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="backgroundTint">?attr/vitalAccent</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">#33000000</item>
    </style>
    <!-- Quiet secondary action. -->
    <style name="Widget.Vital.Button.Tonal">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_high</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>
    <style name="Widget.Vital.Button.Success">
        <item name="backgroundTint">@color/success</item>
    </style>
    <style name="Widget.Vital.Button.Danger">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/danger</item>
    </style>

    <!-- ================= Fields ================= -->
    <style name="Widget.Vital.Field" parent="">
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- ================= Existing styles (kept) ================= -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.DRWatch.Alert" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="vitalAccent">@color/danger</item>
        <item name="vitalAccentSoft">#29FF453A</item>
    </style>

    <!-- AlertDialog theme for the watch -->
    <style name="AlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:background">@color/dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/WearAlertDialogButtonStyle</item>
        <item name="vitalAccent">@color/brand</item>
        <item name="vitalAccentSoft">@color/brand_soft</item>
    </style>

    <style name="WearAlertDialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
